/* This file is the descriptor for the python runnable auto-documentation-generation */
{
    "meta": {
        // label: name of the runnable as displayed, should be short
        "label": "Automatically generate descriptions for datasets, projects, flowzones",

        // description: longer string to help end users understand what this runnable does
        "description": "Macro to locate empty descriptions for projects, flowzones, and datasets and automatically fill them in use Dataiku's AI Services.",

        // icon: must be one of the FontAwesome 5.15.4 icons, complete list here at https://fontawesome.com/v5/docs/
        // "icon": "fas fa-puzzle-piece"
        "icon": "fas fa-fill"
    },

    /* whether the runnable's code is untrusted */
    "impersonate": false,


    /* params:
    DSS will generate a formular from this list of requested parameters.
    Your component code can then access the value provided by users using the "name" field of each parameter.

    Available parameter types include:
    STRING, INT, DOUBLE, BOOLEAN, DATE, SELECT, TEXTAREA, DATASET, DATASET_COLUMN, MANAGED_FOLDER, PRESET and others.

    For the full list and for more details, see the documentation: https://doc.dataiku.com/dss/latest/plugins/reference/params.html
    */
    "params": [
          {
            "name": "save_description",
            "label": "Apply AI generated changes (uncheck for dry run)",
            "type": "BOOLEAN",
            "defaultValue": False
          },
        {
              "name": "project_filter",
              "label": "Project filter",
              "type": "SELECT",
              "defaultValue": "this_project_only",
              "selectChoices" : [
                   { "value": "this_project_only", "label": "This project only"},
                   { "value": "all_projects",      "label": "All projects (no filter)"}
                  //  { "value": "project_tags", "label": "Project tag(s)"},
                  //  { "value": "project_folder", "label": "Project folder(s)"}
              ],
              "mandatory": true
          },
        {
              "name": "object_types_to_autofill",
              "label": "Types of objects to auto-fill empty descriptions",
              "type": "MULTISELECT",
              "selectChoices" : [
                  { "value": "projects", "label": "Project descriptions"},
                    { "value": "flowzones", "label": "Flowzone descriptions"},
                    { "value": "datasets", "label": "Dataset long and short descriptions, and column descriptions"}
              ],
              "mandatory": true
          },
        {
              "name": "language",
              "label": "Language",
              "type": "SELECT",
              "defaultValue": "english",
              "selectChoices" : [
                  { "value": "english", "label": "English"},
                    { "value": "dutch", "label": "Dutch"},
                    { "value": "french", "label": "French"},
                    { "value": "german", "label": "German"},
                    { "value": "portuguese", "label": "Portuguese"},
                    { "value": "spanish", "label": "Spanish"}
              ],
              "mandatory": true
          },
        {
              "name": "project_purpose",
              "label": "Purpose for Project description",
              "type": "SELECT",
              "defaultValue": "generic",
              "selectChoices" : [
                  { "value": "generic", "label": "Generic"},
                    { "value": "technical", "label": "Technical"},
                    { "value": "business_oriented", "label": "Business oriented"},
                    { "value": "executive", "label": "Executive"}
              ],
              "mandatory": false,
              "visibilityCondition": "model.object_types_to_autofill.includes('projects')"
          },
        {
              "name": "project_length",
              "label": "Length for Project description",
              "type": "SELECT",
              "defaultValue": "medium",
              "selectChoices" : [
                  { "value": "low", "label": "Short"},
                    { "value": "medium", "label": "Medium"},
                    { "value": "high", "label": "Long"}
              ],
              "mandatory": true,
              "visibilityCondition": "model.object_types_to_autofill.includes('projects')"

          },
        {
              "name": "flowzone_purpose",
              "label": "Purpose for flow zone description",
              "type": "SELECT",
              "defaultValue": "generic",
              "selectChoices" : [
                  { "value": "generic", "label": "Generic"},
                    { "value": "technical", "label": "Technical"},
                    { "value": "business_oriented", "label": "Business oriented"},
                    { "value": "executive", "label": "Executive"}
              ],
              "mandatory": true,
              "visibilityCondition": "model.object_types_to_autofill.includes('flowzones')"

          },
        {
              "name": "flowzone_length",
              "label": "Length for flowzone description",
              "type": "SELECT",
              "defaultValue": "medium",
              "selectChoices" : [
                  { "value": "low", "label": "Short"},
                    { "value": "medium", "label": "Medium"},
                    { "value": "high", "label": "Long"}
              ],
              "mandatory": true,
              "visibilityCondition": "model.object_types_to_autofill.includes('flowzones')"
          }
       /* {
            "name": "tagname_aigen",
            "label": "Tag name to indicate it was AI generated",
            "type": "STRING",
            "defaultValue": "AI_generated_description"
        },
        {
            "name": "tagname_DoNotAutoFill",
            "label": "Tag name to indicate this object should NOT be automatically filled with AI generated descriptions",
            "type": "STRING",
            "defaultValue": "Do_not_fill_description_using_AI"
        }
        */
    ],

    /* list of required permissions on the project to see/run the runnable */
    "permissions": [],

    /* what the code's run() returns:
       - NONE : no result
       - HTML : a string that is a html (utf8 encoded)
       - FOLDER_FILE : a (folderId, path) pair to a file in a folder of this project (json-encoded)
       - FILE : raw data (as a python string) that will be stored in a temp file by DSS
       - URL : a url
     */
    "resultType": "HTML",

    /* label to use when the runnable's result is not inlined in the UI (ex: for urls) */
    "resultLabel": "my production",

    /* for FILE resultType, the extension to use for the temp file */
    "extension": "txt",

    /* for FILE resultType, the type of data stored in the temp file */
    "mimeType": "text/plain",

    /* Macro roles define where this macro will appear in DSS GUI. They are used to pre-fill a macro parameter with context.

       Each role consists of:
        - type: where the macro will be shown
            * when selecting DSS object(s): DATASET, DATASETS, API_SERVICE, API_SERVICE_VERSION, BUNDLE, VISUAL_ANALYSIS, SAVED_MODEL, MANAGED_FOLDER
            * in the global project list: PROJECT_MACROS
        - targetParamsKey(s): name of the parameter(s) that will be filled with the selected object
    */
    "macroRoles": [
     /* {
            "type": "DATASET",
            "targetParamsKey": "input_dataset"
        } */
    ]
}
